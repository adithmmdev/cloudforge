services:
  client:
    image: cloudforge-{{ project_id }}-client:{{ deployment_id }}
    ports: ["{{ host_port }}:80"]
    depends_on: [server]
    networks: [cloudforge-net]
    deploy:
      resources:
        limits: { memory: {{ client.mem_limit | default('256M') }}, cpus: "0.5" }
  server:
    image: cloudforge-{{ project_id }}-server:{{ deployment_id }}
    expose: ["{{ server.backend_internal_port }}"]
    environment:
      - {{ server.mongo_config.env_var }}=mongodb://mongo:27017/{{ server.mongo_config.db_name }}{% if server.mongo_config.options %}?{{ server.mongo_config.options }}{% endif %}
      - PORT={{ server.backend_internal_port }}
    depends_on:
      mongo:
        condition: service_healthy
    networks: [cloudforge-net]
    deploy:
      resources:
        limits: { memory: {{ server.mem_limit | default('256M') }}, cpus: "0.5" }
  mongo:
    image: mongo:7
    volumes: ["mongo-data:/data/db"]
    networks: [cloudforge-net]
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s
    deploy:
      resources:
        limits: { memory: 256M, cpus: "0.5" }
networks:
  cloudforge-net: {}
volumes:
  mongo-data: {}
