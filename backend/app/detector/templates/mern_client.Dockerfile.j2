FROM node:{{ node_version | default('18') }}-slim AS build
WORKDIR /app
COPY package*.json ./
COPY .cf_npm_cache/ .cf_npm_cache/
RUN if [ -f package-lock.json ]; then npm ci --cache .cf_npm_cache --prefer-offline --offline --no-audit --legacy-peer-deps; else npm install --cache .cf_npm_cache --prefer-offline --offline --no-audit --legacy-peer-deps; fi
COPY . .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/{{ build_output_dir }} /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
