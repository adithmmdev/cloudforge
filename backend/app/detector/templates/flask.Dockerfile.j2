FROM python:3.12-slim
WORKDIR /code
COPY requirements.txt* pyproject.toml* ./
COPY .cf_deps/ .cf_deps/
RUN if [ -f requirements.txt ]; then pip install --no-index --find-links=./.cf_deps -r requirements.txt; \
    elif [ -f pyproject.toml ]; then pip install --no-index --find-links=./.cf_deps .; fi
COPY . .
EXPOSE 8000
CMD ["gunicorn", "-b", "0.0.0.0:8000", "{{ wsgi_module }}"]
